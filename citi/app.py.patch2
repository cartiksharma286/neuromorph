 @app.route('/api/market_data')
 def market_data():
     months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
     sp500_base = 5000
     lithium_base = 14000
     vix_base = 13.5
     
     sp500 = [{"month": m, "price": round(sp500_base * (1 + (i*0.01) + random.uniform(-0.02, 0.02)), 2)} for i, m in enumerate(months)]
     lithium = [{"month": m, "price": round(lithium_base * (1 + (i*0.02) + random.uniform(-0.05, 0.05)), 2)} for i, m in enumerate(months)]
     vix = [{"month": m, "price": round(vix_base * (1 + random.uniform(-0.1, 0.2)), 2)} for m in months]
     
+    # Generate Yield Curve characteristics
+    yield_curve = []
+    for i, m in enumerate(["1M", "3M", "6M", "1Y", "2Y", "5Y", "10Y", "30Y"]):
+        yield_curve.append({
+            "maturity": m,
+            "treasury_yield": round(4.5 + (i * 0.1) - (1.0 if i < 3 else 0.0) + random.uniform(-0.2, 0.2), 2),
+            "corporate_yield": round(5.5 + (i * 0.15) + random.uniform(-0.2, 0.2), 2)
+        })
+        
     return jsonify({
         "sp500": sp500,
         "lithium": lithium,
         "vix": vix,
+        "yield_curve": yield_curve,
         "meta": {
             "sp_target": sp500[-1]["price"],
             "lithium_target": lithium[-1]["price"],
             "vix_target": vix[-1]["price"]
         }
     })
 
